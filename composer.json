{
  "name": "jord-jd/php-stackexchange-search",
  "description": "PHP StackExchange Search",
  "type": "library",
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "require": {
    "php": ">=7.1",
    "jord-jd/php-base-search": "^4.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^7.5||^9.6||^10.5||^11.5||^12.5"
  },
  "autoload": {
    "psr-4": {
      "JordJD\\StackExchangeSearch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JordJD\\StackExchangeSearch\\Tests\\": "tests/Unit/"
    }
  },
  "replace": {
    "divineomega/php-stackexchange-search": "self.version"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.1-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": false
    }
  }
}
